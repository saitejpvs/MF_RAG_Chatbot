# Copy to .env and fill in. Leave the key empty to use the extractive fallback
# (facts are copied from retrieved chunks only, so answers stay safe but terse).

# Any OpenAI-compatible endpoint: OpenAI, Groq, Ollama, LM Studio, vLLM.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Reasoning-style models (gpt-oss) spend part of the budget on hidden reasoning, so
# leave this well above MAX_ANSWER_SENTENCES worth of prose.
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF=2.0

# Follow-up resolution. See Docs/architecture.md 6.2.1.
MEMORY_WINDOW_MESSAGES=10
# 1 = also paraphrase follow-ups with the LLM (one extra call per turn).
MEMORY_LLM_REWRITE=0
